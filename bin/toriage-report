#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "使い方: toriage-report <PR番号> < 判断材料.json" >&2
  exit 2
fi

fail() {
  echo "$1" >&2
  exit 1
}

for tool in gh jq curl; do
  command -v "$tool" >/dev/null || fail "$tool が見つからない"
done

script="$(readlink -f -- "$0")" || fail "スクリプトの置き場所が分からない"
root="$(CDPATH='' cd -- "$(dirname -- "$script")/.." && pwd -P)"
python="$root/libexec/toriage-python"
"$python" -c 'pass' || exit 1
dashboard="${TORIAGE_URL:-http://127.0.0.1:8787}"
dashboard="${dashboard%/}"
inbox="$("$root/libexec/toriage-home")/inbox"

judgment="$(cat)"
jq -e -s 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1 <<<"$judgment" ||
  fail "判断材料が JSON のオブジェクト 1 つとして読めない"
facts="$(gh pr view "$1" --json number,url,title,headRefName,additions,deletions,changedFiles)" ||
  fail "gh で PR $1 を読めなかった"

branch="$(git branch --show-current 2>/dev/null)" || branch=""
workdir="$(git rev-parse --show-toplevel 2>/dev/null)" || workdir=""

body="$(jq -c --argjson facts "$facts" --arg session_id "${CLAUDE_CODE_SESSION_ID:-}" \
  --arg branch "$branch" --arg workdir "$workdir" '
  . + {
    session: (
      if $session_id != "" and $workdir != "" and $branch == $facts.headRefName
      then {id: $session_id, workdir: $workdir}
      else null
      end
    ),
    repo: ($facts.url | split("/") | "\(.[3])/\(.[4])"),
    number: $facts.number,
    url: $facts.url,
    title: $facts.title,
    branch: $facts.headRefName,
    changes: {
      files: $facts.changedFiles,
      additions: $facts.additions,
      deletions: $facts.deletions
    }
  }' <<<"$judgment")"
read -r label name < <(jq -r '"\(.repo)#\(.number) \(.repo | sub("/"; "_"))-\(.number)"' <<<"$body")

problem="$("$python" -I "$root/server.py" --check 2>&1 <<<"$body")" ||
  fail "報告が検証に通らない: $problem"

response="$(mktemp)"
errors="$(mktemp)"
trap 'rm -f "$response" "$errors"' EXIT

post() {
  curl_exit=0
  status="$(curl -sS --noproxy '*' --max-time 10 -o "$response" -w '%{http_code}' \
    -X POST "$dashboard/api/prs" -H 'Content-Type: application/json' \
    --data-binary @- <<<"$body" 2>"$errors")" || curl_exit=$?
}

post
if [ "$curl_exit" -eq 7 ] && [ -z "${TORIAGE_URL:-}" ] && "$root/bin/toriage-start"; then
  post
fi

case "$curl_exit" in
  0) ;;
  6 | 7)
    mkdir -p "$inbox"
    printf '%s\n' "$body" >"$inbox/$name.json"
    echo "ダッシュボードにつながらないので $inbox/$name.json に保存した。次に起動したときに取り込まれる" >&2
    exit 0
    ;;
  *)
    fail "ダッシュボードに届いたか分からない。送り直してよい: $(cat "$errors")"
    ;;
esac
[ "$status" = "200" ] || fail "ダッシュボードに断られた($status): $(cat "$response")"

saved="$(jq -r '.saved' "$response" 2>/dev/null)" || saved=""
case "$saved" in
  true)
    echo "ダッシュボードに送った: $label"
    if [ "${TORIAGE_OPEN:-}" != 0 ]; then
      opener=""
      if [ "$(uname -s)" = Darwin ]; then
        opener=open
      elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        opener=xdg-open
      fi
      if [ -n "$opener" ] && command -v "$opener" >/dev/null; then
        nohup "$opener" "$dashboard" </dev/null >/dev/null 2>&1 &
      fi
    fi
    ;;
  false)
    echo "ダッシュボードには $label のもっと新しい報告があるので、置き換えなかった" >&2
    ;;
  *)
    fail "ダッシュボードの応答が読めない: $(cat "$response")"
    ;;
esac
