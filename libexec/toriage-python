#!/usr/bin/env bash
set -euo pipefail

if python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
  exec python3 "$@"
fi
if command -v uv >/dev/null; then
  exec uv run --quiet --no-project --python '>=3.9' python "$@"
fi
echo "toriage には python3 3.9 以上か uv が要る(今の python3 は $(python3 --version 2>/dev/null || echo 'なし'))" >&2
exit 1
